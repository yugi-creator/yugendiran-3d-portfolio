# ==============================================================================
# Portfolio Environment Variable Configuration Template
# Project: yugendiran.in
# Architecture: Cloudflare Edge -> VPS Nginx -> Express API -> PostgreSQL 16 + Redis 7
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Never commit real credentials or .env files to Git.
# 2. For local development, copy this file to .env.
# 3. For production deployment, set these variables via your VPS environment or CI/CD secrets.
#
# ==============================================================================
# 1. APPLICATION & SERVER SETTINGS
# ==============================================================================
# Port for the Node.js backend to listen on (internal container port).
PORT=3001

# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS origins for browser API access (comma-separated).
# In production, this MUST be set to your exact domain(s) using HTTPS without wildcards.
# Example production: ALLOWED_ORIGIN=https://yugendiran.in,https://www.yugendiran.in
# Example development: ALLOWED_ORIGIN=https://yugendiran.in,http://localhost:5173
ALLOWED_ORIGIN=https://yugendiran.in,http://localhost:5173

# Number of reverse proxy hops in front of Express to trust (1 for Nginx).
# Configures Express `trust proxy` so req.ip correctly resolves from trusted proxies.
TRUST_PROXY=1

# ==============================================================================
# 2. POSTGRESQL 16 DATABASE
# ==============================================================================
# In production Docker Compose, 'postgres' is the internal container hostname.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://portfolio:dev_password@localhost:5432/portfolio

# Individual variables used by the postgres Docker container in docker-compose.yml:
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace_with_a_strong_random_db_password_in_production

# ==============================================================================
# 3. REDIS 7 (RATE LIMITING)
# ==============================================================================
# In production Docker Compose, 'redis' is the internal container hostname.
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:dev_password@localhost:6379

# Password used by the redis Docker container in docker-compose.yml:
REDIS_PASSWORD=replace_with_a_strong_random_redis_password_in_production

# ==============================================================================
# 4. SECURITY & CRYPTOGRAPHIC HASHING
# ==============================================================================
# Server-side secret key used to compute irreversible HMAC-SHA256 hashes of client IPs.
# Must be at least 32 characters long. Never use the default development string in production!
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
IP_HASH_SECRET=replace_with_a_secure_random_32_character_string_for_production

# ==============================================================================
# 5. RESEND EMAIL SERVICE (SERVER-SIDE ONLY)
# ==============================================================================
# Your secret API key from Resend (https://resend.com).
# NEVER expose this key to the browser or frontend bundle!
RESEND_API_KEY=re_replace_with_your_actual_resend_api_key

# Verified sender address configured on your verified domain in Resend.
# Example: Portfolio Contact <contact@yugendiran.in>
CONTACT_FROM_EMAIL=Portfolio Contact <contact@example.com>

# Destination email address where contact submissions are forwarded.
CONTACT_RECIPIENT_EMAIL=recipient@example.com

# ==============================================================================
# 6. CONTACT ENDPOINT RATE LIMITING
# ==============================================================================
# Maximum number of submissions allowed per client IP within the window.
CONTACT_RATE_LIMIT_MAX=3

# Time window in seconds for the rate limit (60 seconds = 1 minute).
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
